# =============================================================================
# Capstone: Tech News Knowledge Graph Schema
# =============================================================================
# Run each block separately. This creates the full capstone schema.

# --- Companies ---
:create company {
    id: String
    =>
    name: String,
    industry: String,
    hq_city: String?,
    founded_year: Int?,
    description: String,
    embedding: <F32; 384>
}

