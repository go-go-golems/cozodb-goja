# =============================================================================
# Module 2 Exercise: Complete Schema Setup
# =============================================================================
# This script creates the full entity extraction schema from the project.
# Run each block separately (CozoDB executes one query at a time).

# --- Step 1: Create the person relation ---
:create person {
    id: String
    =>
    name: String,
    description: String,
    first_mentioned: String,
    embedding: <F32; 384>
}

