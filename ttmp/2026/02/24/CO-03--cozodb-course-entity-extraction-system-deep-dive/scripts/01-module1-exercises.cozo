# =============================================================================
# Module 1 Exercises: CozoDB Fundamentals
# =============================================================================
# Run these in a CozoDB client (Python: db.run(...), or the web UI)
# Each exercise is a standalone query.

# --- Exercise 1.1: Hello CozoDB ---
# Return a table of world cities

?[city, country, population_millions] <- [
    ['Tokyo', 'Japan', 37.4],
    ['Delhi', 'India', 32.9],
    ['Shanghai', 'China', 28.5],
    ['Sao Paulo', 'Brazil', 22.4]
]

# --- Exercise 1.2: Filtering ---
